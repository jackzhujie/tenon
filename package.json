{
  "name": "tenon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tenon（榫）— 本地优先、可自托管的对话式 AI 全栈应用搭建平台",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "spike:db": "pnpm --filter @tenon/spike-db start",
    "spike:agent": "pnpm --filter @tenon/spike-agent start",
    "spike:gateway": "pnpm --filter @tenon/spike-gateway start",
    "spike:loc": "pnpm --filter @tenon/spike-loc start",
    "spike:chord": "pnpm --filter @tenon/spike-chord start",
    "spike:db:probe": "pnpm --filter @tenon/spike-db exec tsx src/probe.ts",
    "typecheck": "tsc --noEmit -p plugins && tsc --noEmit -p packages/protocol && tsc --noEmit -p packages/component-host && tsc --noEmit -p packages/core && tsc --noEmit -p packages/generator && tsc --noEmit -p packages/db-provisioner && tsc --noEmit -p packages/runtime-sdk && tsc --noEmit -p packages/gateway && tsc --noEmit -p packages/agent && tsc --noEmit -p packages/server && tsc --noEmit -p apps/web && tsc --noEmit -p apps/desktop && tsc --noEmit -p spikes/db && tsc --noEmit -p spikes/agent && tsc --noEmit -p spikes/gateway && tsc --noEmit -p spikes/loc && tsc --noEmit -p spikes/chord && tsc --noEmit -p tsconfig.scripts.json",
    "dev:server": "tsx packages/server/src/bin.ts",
    "dev:faux": "TENON_FAUX=1 tsx packages/server/src/bin.ts",
    "dev:web": "tsx scripts/dev-web.ts",
    "build:web": "pnpm --filter @tenon/web build",
    "build:desktop": "pnpm build:web && pnpm build:plugins && node apps/desktop/build.mjs",
    "dev:desktop": "pnpm build:desktop && pnpm --filter @tenon/desktop start",
    "pack:desktop": "pnpm build:desktop && pnpm --filter @tenon/desktop exec electron-builder --dir",
    "smoke:desktop": "pnpm build:desktop && tsx scripts/smoke-desktop.ts",
    "smoke:desktop:packaged": "tsx scripts/smoke-desktop.ts --packaged",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "e2e:preview": "tsx scripts/e2e-preview.ts",
    "e2e:fullstack": "tsx scripts/e2e-fullstack.ts",
    "e2e:inspector": "tsx scripts/e2e-inspector.ts",
    "e2e:diff": "tsx scripts/e2e-diff.ts",
    "e2e:release": "tsx scripts/e2e-release.ts",
    "e2e:e2e": "tsx scripts/e2e-e2e-agent.ts",
    "clean": "rm -rf node_modules **/node_modules",
    "build:plugins": "tsx scripts/build-plugins.ts",
    "pretest": "tsx scripts/build-plugins.ts",
    "e2e:component": "tsx scripts/e2e-component.ts",
    "e2e:provider": "tsx scripts/e2e-provider.ts",
    "e2e:real": "tsx scripts/e2e-real.ts",
    "shot:settings": "tsx scripts/shot-settings.ts",
    "pack:plugin": "tsx scripts/pack-plugin.ts",
    "e2e:hub": "tsx scripts/e2e-hub.ts",
    "shot:plugins": "tsx scripts/shot-plugins.ts"
  },
  "devDependencies": {
    "@tenon/protocol": "workspace:*",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "vitest": "5.0.5",
    "@earendil-works/chord": "1.4.0",
    "esbuild": "0.28.2",
    "typebox": "1.3.27"
  }
}
