{
  "name": "{{appSlug}}",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev:web": "vite",
    "build:api": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "start:api": "node dist-server/api/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "pnpm run typecheck && vite build"
  },
  "tenon": {
    "api": "api/main.ts",
    "apiOut": "dist-server/api/main.js",
    "apiTsconfig": "tsconfig.server.json"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/typeorm": "12.0.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7"
  }
}
