# ---- 依赖与构建 ----
node_modules/
dist/
dist-electron/
out/
# 只忽略 electron-builder 的产物目录。**不要写成 `release/`**：
# 那样会连 apps/web/src/features/release/ 一起忽略，而 Tailwind 的内容扫描会跳过
# .gitignore 命中的路径 —— 新加的类名不生成 CSS，界面上"只有新写的样式失效"，极难查
/apps/desktop/release/
*.tsbuildinfo
.turbo/
.pnpm-store/

# ---- 日志与临时 ----
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# ---- 本地数据（绝不入库）----
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.studio/
.env
.env.local

# ---- 逆向研究产物（内部，不随开源发布）----
docs/reverse/
*.har
*.saz
*.mitm

# ---- 组件构建产物（源码在 plugins/bundled/<id>/*.ts，先跑 build:plugins）----
plugins/bundled/*/server.js
plugins/bundled/*/web.js
plugins/bundled/*/worker.js

# ---- spike 运行产物（结果 JSON 保留入库作为证据）----
spikes/*/pgdata*
spikes/*/work/

# ---- IDE ----
.idea/
.vscode/
!.vscode/extensions.json

# 内部研究材料，不进公开仓库（DESIGN §16 / README 的「不随开源发布」）
docs/reverse/
*.har
docs/REVERSE_ENGINEERING.md

# 工作区记忆（Agent 的草稿本）：这是**本地**文件，不是项目文档
#
# 它曾经入库过，代价是别的会话写的笔记（磁盘盘点、别的项目的路径、
# 桌面目录里有什么）一起进了公开仓库 —— 一个人的草稿本不该是仓库的一部分。
# 项目本身的知识都在 docs/STATUS.md 与 docs/TRAPS.md，那两个该入库。
.workbuddy/
